# npm 12 refuses registry tarballs of packages with bundleDependencies (snyk)
# when it builds a tree without a lockfile, e.g. Renovate lock file maintenance:
# EALLOWREMOTE, npm/cli#9800. "all" is npm 11's default. Remove once fixed.
allow-remote=all

# npm resolves only versions published at least 3 days ago, matching Renovate's
# minimumReleaseAge. Renovate gates lock file maintenance by passing --before,
# but when a package.json floor is younger than that it retries without
# --before and logs only at debug level, so the gate silently drops: in #868
# the same-day jest-cucumber-fusion ^3.0.4 bump let 15 packages under 3 days
# old into the lock file. With min-release-age here Renovate skips --before and
# npm enforces the window itself, so a young floor now fails with ETARGET.
# A security fix published under 3 days ago fails the same way; npm audit fix
# keeps the vulnerable version and exits non-zero. Raise it by hand if needed.
min-release-age=3
# Own packages, published and adopted the same day. Only the named packages
# are exempt; their dependencies still follow the window.
min-release-age-exclude=@g_package/*
